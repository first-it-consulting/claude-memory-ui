{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  packageRules: [
    {
      description: 'Group minor and patch updates (npm + Actions) into one PR',
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'minor and patch updates',
    },
    {
      description: 'Automerge minor/patch/digest/pin PRs only when all checks pass',
      matchUpdateTypes: ['minor', 'patch', 'digest', 'pin', 'pinDigest'],
      automerge: true,
      automergeType: 'pr',
      ignoreTests: false,
    },
    {
      description: 'Never automerge major updates - review them by hand',
      matchUpdateTypes: ['major'],
      automerge: false,
    },
    {
      description: 'Never automerge Python/Node runtime updates',
      matchDepNames: ['python', 'node'],
      automerge: false,
    },
    {
      // Runtime version pins (setup-python/setup-node, Dockerfile FROM
      // python/node) are deliberate, tested upgrades. Renovate counts
      // 3.13 -> 3.15 as MINOR, so disable these depNames for ALL update
      // types. matchDepNames is exact-match, so pip/npm packages are
      // unaffected; manual bumps only.
      description: 'No Python/Node runtime version PRs at all (manual bumps only)',
      matchDepNames: ['python', 'node'],
      enabled: false,
    },
    {
      // Docker base images (FROM lines, bake/compose pins) and release-please
      // bookkeeping stay human-gated regardless of update type.
      description: 'Never automerge Dockerfile/base-image or release-please file changes',
      matchFileNames: [
        '**/Dockerfile*',
        '**/*.bake.hcl',
        '**/docker-compose*.y*ml',
        'release-please-config.json',
        '.release-please-manifest.json',
        '**/CHANGELOG.md',
      ],
      automerge: false,
    },
  ],
}
